{
  "name": "agora-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Modular MERN backend for the Agora trading, brokerage, exchange and custody platform",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "prebuild": "node scripts/check-deploy-env.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint src api tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:indexes": "tsx src/scripts/sync-indexes.ts",
    "db:sanity": "tsx src/scripts/database-sanity.ts",
    "db:setup": "npm run migrate:users && npm run seed && npm run db:indexes && npm run db:sanity",
    "migrate:users": "tsx src/scripts/migrate-users.ts",
    "verify:users": "tsx src/scripts/verify-users.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "compression": "1.8.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.24.5",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.0",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.13"
  }
}
